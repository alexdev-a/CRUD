<div id="<%= dom_id pessoa %>">
  <div>
    <strong>Nome:</strong>
    <%= pessoa.nome %>
  </div>

  <div>
    <strong>Telefone:</strong>
    <%= pessoa.telefone %>
  </div>

  <div>
    <strong>Email:</strong>
    <%= pessoa.email %>
  </div>

  <div>
    <strong>CPF:</strong>
    <%= formatar_cpf(pessoa.cpf) %>
  </div>

</div>

<%= form_with(model: pessoa, class: "needs-validation", novalidate: true) do |form| %>
  <% if pessoa.errors.any? %>
    <div class="alert alert-danger">
      <h4 class="alert-heading">
        <i class="bi bi-exclamation-triangle-fill"></i> Atenção!
      </h4>
      <p>
        <%= pluralize(pessoa.errors.count, "erro", "erros") %>
        <%= pessoa.errors.count == 1 ? "impediu" : "impediram" %>
        que essa pessoa fosse salva:
      </p>
      <ul class="mb-0">
        <% pessoa.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <!-- NOME -->
  <div class="mb-3">
    <%= form.label :nome, "Nome", class: "form-label" %>
    <div class="input-group">
      <span class="input-group-text">
        <i class="bi bi-person-fill"></i>
      </span>
      <%= form.text_field :nome,
          class: "form-control",
          placeholder: "Digite o nome completo" %>
    </div>
  </div>

  <!-- TELEFONE -->
  <div class="mb-3">
    <%= form.label :telefone, "Telefone", class: "form-label" %>
    <div class="input-group">
      <span class="input-group-text">
        <i class="bi bi-telephone-fill"></i>
      </span>
      <%= form.text_field :telefone,
          class: "form-control",
          placeholder: "(00) 00000-0000" %>
    </div>
  </div>

  <!-- EMAIL -->
  <div class="mb-3">
    <%= form.label :email, "Email", class: "form-label" %>
    <div class="input-group">
      <span class="input-group-text">
        <i class="bi bi-envelope-fill"></i>
      </span>
      <%= form.text_field :email,
          class: "form-control",
          placeholder: "exemplo@email.com" %>
    </div>
  </div>

  <!-- CPF -->
  <div class="mb-4">
    <%= form.label :cpf, "CPF", class: "form-label" %>
    <div class="input-group">
      <span class="input-group-text">
        <i class="bi bi-card-text"></i>
      </span>
      <%= form.text_field :cpf,
          class: "form-control",
          maxlength: "14",
          placeholder: "000.000.000-00" %>
    </div>
  </div>

  <!-- SCRIPT CPF -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const cpfField = document.getElementById('pessoa_cpf');

      if (cpfField) {
        cpfField.addEventListener('input', function(e) {
          let value = e.target.value.replace(/\D/g, '');

          if (value.length <= 11) {
            value = value.replace(/(\d{3})(\d)/, '$1.$2');
            value = value.replace(/(\d{3})(\d)/, '$1.$2');
            value = value.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
          }

          e.target.value = value;
        });
      }
    });
  </script>

  <!-- BOTÃO -->
  <div class="d-grid gap-2">
    <%= form.submit pessoa.new_record? ? "Criar Pessoa" : "Atualizar Pessoa",
        class: "btn btn-primary btn-lg" %>
  </div>

<% end %>